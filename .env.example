MONGO_URI=
# Optioneel; leeg = sessies in dezelfde database als MONGO_URI
MONGO_SESSION_URI=
SESSION_SECRET=
# false = Express serveert client op / (één poort, aanbevolen)
# true = cookies/dev-logging; client blijft via client/dist op dezelfde poort
DEV=false
# true op HTTPS (Railway); false op lokaal http://
COOKIE_SECURE=false
PORT=5055

ADMIN_EMAIL=
CREATE_SECRET=

# SMTP voor account-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
