{
  "name": "projects-captainjohn",
  "version": "1.0.0",
  "private": true,
  "description": "Captain John project tracker – Vue + Express + MongoDB",
  "type": "commonjs",
  "scripts": {
    "install:all": "npm install && npm --prefix ./client install",
    "dev": "npm run build && nodemon server/server.js",
    "dev:vite": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "npm --prefix ./client run dev",
    "build": "node scripts/build-client.js",
    "start": "node server/server.js",
    "prod": "npm run build && node scripts/prod.js",
    "test": "npm run test:node && npm run test:e2e",
    "test:unit": "node --test --test-force-exit \"tests/unit/**/*.test.js\"",
    "test:api": "node --test --test-force-exit \"tests/api/**/*.test.js\"",
    "test:node": "node --test --test-force-exit \"tests/unit/**/*.test.js\" \"tests/api/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:e2e": "node scripts/seed-e2e.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "body-parser": "^1.20.3",
    "connect-history-api-fallback": "^2.0.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mongoose": "^8.13.1",
    "multer": "^1.4.5-lts.1",
    "niceware": "^4.0.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
